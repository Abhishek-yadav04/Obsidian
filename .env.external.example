# -----------------------------------------------------------------------------
# Obsidian Docker Compose environment (external managed DB/Redis)
# Copy to .env.external and run:
#   docker compose --env-file .env.external up -d --build
# -----------------------------------------------------------------------------

# Required
OBSIDIAN_JWT_SECRET=replace-with-32-plus-char-random-secret

# App
OBSIDIAN_PORT=8082
OBSIDIAN_ALLOWED_ORIGINS=http://localhost:8082
LOG_LEVEL=info
LOG_FORMAT=json

# External PostgreSQL and Redis
DATABASE_URL=postgresql://user:password@db-host:5432/obsidian?sslmode=require
REDIS_URL=rediss://default:password@redis-host:6379/0

# postgres service password still required because compose file defines postgres service
# You can set a placeholder if you are not using the local postgres container.
POSTGRES_PASSWORD=unused-placeholder

# Optional OAuth
SUPABASE_URL=
SUPABASE_KEY=

# Optional CRS
OBSIDIAN_CRS_ENABLED=false
OBSIDIAN_CRS_MODE=DetectionOnly
OBSIDIAN_CRS_PATH=/app/crs
# OBSIDIAN_CRS_HOST_PATH=./crs
