# Obsidian WAF Configuration
# Copy this file to .env and configure for your environment

# JWT Secret (REQUIRED - min 32 characters)
OBSIDIAN_JWT_SECRET=change-this-to-a-secure-random-string-min-32-chars

# Server Configuration
OBSIDIAN_PORT=8082
LOG_LEVEL=info
LOG_FORMAT=json

# CORS Origins (REQUIRED for mobile app access)
# Add your laptop's IP address for wireless debugging
# For Android WebView: add http://127.0.0.1:8082 and http://localhost:8082
# For Capacitor apps: add capacitor://localhost and ionic://localhost
OBSIDIAN_CORS_ORIGINS=http://localhost:8082,http://127.0.0.1:8082,capacitor://localhost,ionic://localhost,http://10.0.2.2:8082

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/obsidian

# Redis Cache (Optional)
REDIS_URL=redis://localhost:6379/0

# GeoIP Database (Optional)
GEOIP_DATABASE_PATH=/path/to/GeoLite2-Country.mmdb

# OAuth via Supabase (Optional)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-public-key

# Webhook Alerts (Optional)
OBSIDIAN_SLACK_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
OBSIDIAN_TEAMS_WEBHOOK=https://outlook.office.com/webhook/YOUR/WEBHOOK/URL
OBSIDIAN_DISCORD_WEBHOOK=https://discord.com/api/webhooks/YOUR/WEBHOOK/URL

# OWASP CRS Configuration (Optional)
OBSIDIAN_CRS_ENABLED=false
OBSIDIAN_CRS_PATH=/path/to/coreruleset
OBSIDIAN_CRS_MODE=DetectionOnly
OBSIDIAN_WAF_CUSTOM_RULES=rules/obsidian-custom.conf
