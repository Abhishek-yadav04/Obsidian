# -----------------------------------------------------------------------------
# Obsidian Docker Compose environment (internal postgres + redis services)
# Copy to .env.docker and run:
#   docker compose --env-file .env.docker up -d --build
# -----------------------------------------------------------------------------

# Required
OBSIDIAN_JWT_SECRET=replace-with-32-plus-char-random-secret

# App
OBSIDIAN_PORT=8082
OBSIDIAN_ALLOWED_ORIGINS=http://localhost:8082
LOG_LEVEL=info
LOG_FORMAT=json

# Internal postgres service
POSTGRES_USER=obsidian
POSTGRES_PASSWORD=obsidian
POSTGRES_DB=obsidian

# Optional explicit URLs (defaults already resolve to postgres/redis services)
# DATABASE_URL=postgresql://obsidian:obsidian@postgres:5432/obsidian?sslmode=disable
# REDIS_URL=redis://redis:6379/0

# Optional OAuth
SUPABASE_URL=
SUPABASE_KEY=

# Optional CRS (external rules mounted into container at /app/crs)
OBSIDIAN_CRS_ENABLED=false
OBSIDIAN_CRS_MODE=DetectionOnly
OBSIDIAN_CRS_PATH=/app/crs
# Set host path if you have CRS checked out locally
# OBSIDIAN_CRS_HOST_PATH=./crs
