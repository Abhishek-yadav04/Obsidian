# ============================================================================
# OBSIDIAN SENTINEL WAF - Environment Configuration
# ============================================================================
# Copy this file to .env and customize for your environment
# ⚠️ NEVER COMMIT .env FILES TO VERSION CONTROL
# ============================================================================

# =============================================================================
# JWT AUTHENTICATION (REQUIRED IN PRODUCTION)
# =============================================================================
# Minimum 32 characters, use a cryptographically secure random string
# Generate with: openssl rand -base64 32
OBSIDIAN_JWT_SECRET=your-super-secure-random-secret-minimum-32-characters

# =============================================================================
# ENVIRONMENT MODE
# =============================================================================
# development - Relaxed security, verbose logging, auto-generated JWT secret
# production - Strict security, JWT secret REQUIRED, optimized logging
OBSIDIAN_ENV=development

# =============================================================================
# DATABASE - PostgreSQL (REQUIRED)
# =============================================================================
# Primary database connection (Supabase or other PostgreSQL)
# Format: postgresql://user:password@host:port/database?sslmode=require
DATABASE_URL=postgresql://obsidian_user:your_secure_password@localhost:5432/obsidian_db?sslmode=require
# Docker Compose internal DB example:
# DATABASE_URL=postgresql://obsidian:obsidian@postgres:5432/obsidian?sslmode=disable

# Local fallback (optional, for development)
DATABASE_URL_LOCAL=postgresql://postgres:postgres@localhost:5432/obsidian?sslmode=disable

# =============================================================================
# CACHE - Redis (OPTIONAL)
# =============================================================================
# Enables distributed rate limiting, session clustering
# For TLS use rediss:// scheme
# Format: redis://user:password@host:port/db
REDIS_URL=redis://localhost:6379/0
# For TLS: REDIS_URL=rediss://default:your_password@redis-host.io:6379/0
# Docker Compose internal Redis example:
# REDIS_URL=redis://redis:6379/0

# =============================================================================
# GEOIP BLOCKING (OPTIONAL)
# =============================================================================
# Path to MaxMind GeoLite2-Country.mmdb file
# Download from: https://dev.maxmind.com/geoip/geolite2-free-geolocation-data
GEOIP_DATABASE_PATH=/opt/maxmind/GeoLite2-Country.mmdb

# =============================================================================
# WEBSOCKET SECURITY
# =============================================================================
# Comma-separated list of allowed origins for WebSocket connections
# In production, set to your actual domain(s)
OBSIDIAN_ALLOWED_ORIGINS=http://localhost:8082,https://your-domain.com

# =============================================================================
# LOGGING
# =============================================================================
# Log level: debug, info, warn, error
LOG_LEVEL=info

# Log format: json (structured), console (human-readable)
LOG_FORMAT=json

# =============================================================================
# THREAT INTELLIGENCE (OPTIONAL)
# =============================================================================
# Enable automatic threat feed updates
THREAT_FEEDS_ENABLED=true

# Threat feed update interval (e.g., 4h, 30m)
THREAT_FEED_INTERVAL=4h

# =============================================================================
# ALERTING (OPTIONAL)
# =============================================================================
# Enable webhook alerts for security events
ALERT_WEBHOOKS_ENABLED=true

# Default webhook URL (can also configure via API)
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# =============================================================================
# RATE LIMITING
# =============================================================================
# Use Redis for distributed rate limiting (requires REDIS_URL)
RATE_LIMIT_REDIS=true

# Default rate limit: requests per minute per IP
RATE_LIMIT_DEFAULT=200

# Login rate limit: attempts per minute per IP
RATE_LIMIT_LOGIN=5

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
# Server port (can also use -port flag)
# OBSIDIAN_PORT takes precedence over PORT when both are set
OBSIDIAN_PORT=8082
PORT=8082

# Request timeout (e.g., 30s, 1m)
REQUEST_TIMEOUT=30s

# Maximum request body size (e.g., 10MB, 100KB)
MAX_BODY_SIZE=10MB

# =============================================================================
# PRODUCTION CHECKLIST
# =============================================================================
# Before deploying to production:
# [ ] Set OBSIDIAN_JWT_SECRET to a secure 32+ character random string
# [ ] Set OBSIDIAN_ENV=production
# [ ] Configure PostgreSQL with sslmode=require
# [ ] Change ALL default user passwords (admin, analyst, viewer)
# [ ] Configure OBSIDIAN_ALLOWED_ORIGINS for your domain
# [ ] Set up Redis for distributed rate limiting
# [ ] Configure TLS/SSL via reverse proxy (nginx/Caddy)
# [ ] Enable and configure alerting webhooks
# [ ] Set up log aggregation and monitoring
